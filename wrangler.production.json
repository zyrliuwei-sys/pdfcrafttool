{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdfcrafttool",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://pdfcrafttool.org",
    "VITE_APP_NAME": "PDFCraftTool.org",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_APP_DESCRIPTION": "PdfCraft guide: free open-source PDF reader & editor — download, use online, tutorials and Acrobat comparison.",
    "VITE_PDFCRAFT_WEB_URL": "https://app.pdfcrafttool.org/index.html",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdfcrafttool",
      "database_id": "e0f69c67-a969-4338-8573-e6877788c723",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    {
      "pattern": "pdfcrafttool.org",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
